<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>lshammer</AssemblyName>
    <!-- The FM.LiveSwitch SDK build the CLI is compiled against. -->
    <LiveSwitchSdkVersion>1.27.0.22319</LiveSwitchSdkVersion>
    <!-- The CLI release version. The first three components must match the SDK release
         and the fourth counts CLI-only changes; see "Releases" in README.md. The release
         workflow fails if the tag does not match this value. -->
    <Version>1.27.0</Version>
    <!-- IL2104: trimmer summary warning caused by CommandLineParser not being trim-compatible.
         NETSDK1206: version-specific RID warning from SkiaSharp in the FM.LiveSwitch SDK. -->
    <NoWarn>$(NoWarn);IL2104;NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRootDescriptor.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="FM.LiveSwitch" Version="$(LiveSwitchSdkVersion)" />
    <PackageReference Include="FM.LiveSwitch.Opus" Version="$(LiveSwitchSdkVersion)" />
    <PackageReference Include="FM.LiveSwitch.Vpx" Version="$(LiveSwitchSdkVersion)" />
  </ItemGroup>
</Project>
