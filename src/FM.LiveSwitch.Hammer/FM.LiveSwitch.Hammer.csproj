<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>lshammer</AssemblyName>
    <!-- Tracks the FM.LiveSwitch SDK version below. Bump in the same commit that gets
         tagged for release; see "Releases" in README.md. -->
    <Version>1.27.0</Version>
    <!-- IL2104: trimmer summary warning caused by CommandLineParser not being trim-compatible.
         NETSDK1206: version-specific RID warning from SkiaSharp in the FM.LiveSwitch SDK. -->
    <NoWarn>$(NoWarn);IL2104;NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRootDescriptor.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="FM.LiveSwitch" Version="1.27.0.22319" />
    <PackageReference Include="FM.LiveSwitch.Opus" Version="1.27.0.22319" />
    <PackageReference Include="FM.LiveSwitch.Vpx" Version="1.27.0.22319" />
  </ItemGroup>
</Project>
